# --- Telegram -----------------------------------------------------------
# Grab one from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma separated numeric Telegram ids that may use /admin commands
ADMIN_USER_IDS=

# --- Solana -------------------------------------------------------------
# Any RPC works, but a paid endpoint is strongly recommended: the public
# endpoint rate limits hard and swaps will start failing under load.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
# Jupiter aggregator (v6). Self-hosted instances work too.
JUPITER_API_URL=https://quote-api.jup.ag/v6
PRICE_API_URL=https://api.jup.ag/price/v2

# --- Wallet encryption --------------------------------------------------
# 32 byte hex secret. Generate with: openssl rand -hex 32
# Rotating this makes every stored wallet unreadable. Back it up.
WALLET_ENCRYPTION_KEY=

# --- Trading defaults ---------------------------------------------------
DEFAULT_SLIPPAGE_BPS=150
DEFAULT_PRIORITY_FEE_LAMPORTS=200000
# Fee charged by this deployment, in basis points (100 = 1%). 0 disables it.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_WALLET=

# --- Runtime ------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_PATH=./data/bonkbot.db
API_PORT=8787
# Comma separated origins allowed to call the dashboard API
API_CORS_ORIGINS=http://localhost:5173
